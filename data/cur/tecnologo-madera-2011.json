  "conflicts": [
    {
      "field": "trajectoryAuthority",
      "resolution": "DGETP-UTU republica en su ficha vigente las 54 ubicaciones del Anexo III, titulado posible implementación. Se conserva como guía semestral flexible oficial, no como secuencia obligatoria."
    },
    {
      "field": "annexIvExamples",
      "resolution": "Los tres cuadros del Anexo IV son ejemplos de currículos de 267, 262 y 271 créditos. No son menciones, perfiles certificados ni trayectorias predeterminadas separadas."
    },
    {
      "field": "marketingIdentity",
      "resolution": "El Anexo III y la ficha vigente publican Marketing; el Anexo II y Bedelías publican GP1 Comercialización sin equivalencia explícita. Marketing se conserva como identidad oficial sólo-fuente y GP1 permanece candidata."
    },
    {
      "field": "TIMEM.credits",
      "resolution": "El Plan imprime guion en el Anexo II y S/C en el Anexo IV para el Taller Introductorio; se proyecta con 0 créditos y aprobación obligatoria. Los 11 créditos de Bedelías quedan trazados como conflicto operativo."
    },
    {
      "field": "ETC4.credits",
      "resolution": "El Anexo II imprime 5 créditos, pero sus diez obligatorias suman 65 frente al mínimo normativo de 66; Bedelías publica 6 para ETC4. Se conserva el valor operativo de 6 con conflicto explícito y sin alterar el mínimo de 66."
    },
    {
      "field": "SE4.credits",
      "resolution": "El Anexo III imprime 11 créditos para Automatización y Control, mientras el Anexo II y Bedelías publican 7. Se conservan 7 y la contradicción queda auditada."
    },
    {
      "field": "publishedSemesterCatalogCredits",
      "resolution": "Las 54 ubicaciones reúnen 342 créditos disponibles; el título exige elegir un currículo coherente de 270 créditos con mínimos por área y aprobación de la Comisión. No se suman todas como obligación."
    }
  ],
