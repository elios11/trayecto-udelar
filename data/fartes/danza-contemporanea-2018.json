  "conflicts": [
    {
      "field": "bodyStudiesMinimumCredits",
      "publishedValues": [
        "El texto narrativo del Plan publica 38 créditos mínimos para Estudios del cuerpo",
        "El cuadro resumen y las unidades de la malla suman 43 créditos para Teorías/Estudios del CUERPO"
      ],
      "resolution": "La proyección controla 43 créditos porque el cuadro resumen de la malla y la suma de sus nueve ubicaciones coinciden en 43 y permiten cerrar los 360 créditos publicados. Los 38 del texto narrativo permanecen registrados como contradicción interna del mismo Plan, sin corregirse ni ocultarse."
    },
    {
      "field": "genericSeminarIdentity",
      "publishedValues": [
        "La malla publica Seminarios teórico-analíticos y Seminario de investigación sin código ni edición",
        "Bedelías conserva STAM1, STAM2, SI1 y SI2 como ediciones técnicas concretas"
      ],
      "resolution": "Los dos cupos de la malla se conservan como bloques sólo-fuente de 6 créditos. STAM1, STAM2, SI1 y SI2 permanecen candidatas y no se convierten en equivalencias ni obligaciones acumulativas."
    },
    {
      "field": "finalProjectIdentity",
      "publishedValues": [
        "La malla divide el Trabajo Final en Anteproyecto 10, Feedback 8, Proyecto Realización 10 y Feedback 8",
        "Bedelías agrega LTFE1 y LTFE2 como dos registros de 18 créditos"
      ],
      "resolution": "Se reproducen los cuatro bloques de la malla sin atribuirles los códigos LTFE1/LTFE2, porque el Plan no publica esa equivalencia. Ambos registros técnicos permanecen candidatos y recuperables."
    },
    {
      "field": "flexibleCredits",
