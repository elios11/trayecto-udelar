{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test:unit": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm run test:unit",
    "test": "npm run build && npm run test:unit",
    "package": "node scripts/package-portable-build.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "bedelias:catalog": "node scripts/scrape-bedelias.mjs catalog",
    "bedelias:plan": "node scripts/scrape-bedelias.mjs plan",
    "bedelias:project": "node scripts/build-app-data.mjs",
    "bedelias:project:2025": "node scripts/build-computacion-2025.mjs",
    "bedelias:project:electrica": "node scripts/build-electrica-2023.mjs",
    "bedelias:project:civil": "node scripts/build-civil-2021.mjs",
    "bedelias:inventory": "node scripts/bedelias-global-inventory.mjs",
    "bedelias:report": "node scripts/bedelias-service-report.mjs",
    "bedelias:audit-rules": "node scripts/audit-bedelias-rules.mjs",
    "bedelias:service": "node scripts/scrape-bedelias-service.mjs",
    "bedelias:project:qf": "node scripts/build-quimico-farmaceutico-2015.mjs",
    "bedelias:project:fadu": "node scripts/build-fadu-audited-plans.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "playwright-core": "^1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
